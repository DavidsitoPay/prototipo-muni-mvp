# Copiar a backend/.env y completar con los valores reales de tu proyecto Neon.
# Usar el endpoint DIRECTO (sin "-pooler" en el host), no el pooled.
DATABASE_URL=postgresql+asyncpg://usuario:password@ep-xxxxx.region.aws.neon.tech/muniguate

JWT_SECRET=change-me-dev-secret
JWT_EXPIRE_MINUTES=480

# Motor de recomendaciones: el motor de reglas siempre esta activo.
# LLM_ENABLED habilita el enriquecimiento opcional via Ollama local (opcional,
# requiere tener Ollama corriendo en tu maquina).
LLM_ENABLED=false
OLLAMA_HOST=http://localhost:11434

CORS_ORIGINS=http://localhost:3000
