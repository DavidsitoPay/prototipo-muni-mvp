# Copiar a .env y ajustar si es necesario. Valores por defecto ya funcionan para desarrollo local.

POSTGRES_USER=sgcm
POSTGRES_PASSWORD=sgcm_dev_password
POSTGRES_DB=sgcm

DATABASE_URL=postgresql+asyncpg://sgcm:sgcm_dev_password@db:5432/sgcm

JWT_SECRET=change-me-dev-secret
JWT_EXPIRE_MINUTES=480

# Motor de recomendaciones: el motor de reglas siempre esta activo.
# LLM_ENABLED habilita el enriquecimiento opcional via Ollama local (requiere
# levantar el perfil "llm": docker compose --profile llm up).
LLM_ENABLED=false
OLLAMA_HOST=http://ollama:11434

CORS_ORIGINS=http://localhost:3000

VITE_API_BASE_URL=http://localhost:8000/api
