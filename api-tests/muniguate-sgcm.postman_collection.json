    {
      "name": "2. Flujo de negocio: activo, vulnerabilidad y riesgo",
      "item": [
        {
          "name": "07 Dashboard antes del flujo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/dashboard/summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "dashboard",
                "summary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('Total de activos es un número', () => pm.expect(d.total_assets).to.be.a('number'));",
                  "pm.environment.set('total_assets_antes', d.total_assets);"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Crear activo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/assets",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "assets"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Activo QA Postman\",\n  \"type\": \"servidor\",\n  \"department\": \"Dirección de Informática\",\n  \"criticality\": \"alta\",\n  \"status\": \"activo\",\n  \"owner\": \"Equipo QA\",\n  \"location\": \"nube\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "pm.test('Esquema de activo', () => pm.response.to.have.jsonSchema({type:'object', required:['id','name','type','department','criticality','status','owner','location','created_at','risk_band'], properties:{id:{type:'string'}, name:{type:'string'}, type:{enum:['servidor','aplicacion','base_datos','red','endpoint','sistema_web_publico']}, criticality:{enum:['baja','media','alta','critica']}, status:{enum:['activo','mantenimiento','dado_de_baja']}, location:{enum:['fisico','nube','on_prem']}, risk_band:{enum:[null,'bajo','medio','alto','critico']}}}));",
                  "const a = pm.response.json();",
                  "pm.test('Datos guardados y sin riesgo inicial', () => { pm.expect(a.name).to.eql('Activo QA Postman'); pm.expect(a.criticality).to.eql('alta'); pm.expect(a.risk_band).to.be.null; });",
                  "pm.environment.set('asset_id', a.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "09 Dashboard refleja el nuevo activo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/dashboard/summary",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "dashboard",
                "summary"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Esquema del resumen', () => pm.response.to.have.jsonSchema({type:'object', required:['total_assets','assets_by_criticality','vulnerabilities_by_risk_band','nist_global_maturity_percent','top_risky_assets'], properties:{assets_by_criticality:{type:'array', minItems:4, maxItems:4}, vulnerabilities_by_risk_band:{type:'array', minItems:4, maxItems:4}, top_risky_assets:{type:'array', maxItems:5}}}));",
                  "pm.test('El total de activos aumentó en 1', () => pm.expect(pm.response.json().total_assets).to.eql(Number(pm.environment.get('total_assets_antes')) + 1));"
                ]
              }
            }
          ]
        },
        {
          "name": "10 Registrar vulnerabilidad crítica (5 x 5)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analista_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/assets/{{asset_id}}/vulnerabilities",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "assets",
                "{{asset_id}}",
                "vulnerabilities"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Vulnerabilidad de prueba QA\",\n  \"probability\": 5,\n  \"impact\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 201', () => pm.response.to.have.status(201));",
                  "pm.test('Esquema de vulnerabilidad', () => pm.response.to.have.jsonSchema({type:'object', required:['id','asset_id','description','probability','impact','risk_score','risk_band','status','created_at'], properties:{probability:{type:'integer',minimum:1,maximum:5}, impact:{type:'integer',minimum:1,maximum:5}, risk_score:{type:'integer',minimum:1,maximum:25}, risk_band:{enum:['bajo','medio','alto','critico']}, status:{enum:['abierta','mitigada']}}}));",
                  "const v = pm.response.json();",
                  "pm.test('Riesgo calculado 25, banda crítico, estado abierta', () => { pm.expect(v.risk_score).to.eql(25); pm.expect(v.risk_band).to.eql('critico'); pm.expect(v.status).to.eql('abierta'); pm.expect(v.asset_id).to.eql(pm.environment.get('asset_id')); });",
                  "pm.environment.set('vuln_id', v.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "11 Recomendación generada automáticamente",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{directivo_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/vulnerabilities/{{vuln_id}}/recommendations",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vulnerabilities",
                "{{vuln_id}}",
                "recommendations"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Esquema de lista de recomendaciones', () => pm.response.to.have.jsonSchema({type:'array', items:{type:'object', required:['id','vulnerability_id','source','text','created_at'], properties:{source:{enum:['regla','llm']}, text:{type:'string', minLength:1}}}}));",
                  "const recs = pm.response.json();",
                  "pm.test('Existe al menos una recomendación del motor de reglas', () => pm.expect(recs.some(r => r.source === 'regla')).to.be.true);",
                  "pm.test('Las recomendaciones pertenecen a la vulnerabilidad', () => recs.forEach(r => pm.expect(r.vulnerability_id).to.eql(pm.environment.get('vuln_id'))));"
                ]
              }
            }
          ]
        },
        {
          "name": "12 Activo toma la banda de su vulnerabilidad",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{directivo_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/assets/{{asset_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "assets",
                "{{asset_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Esquema de detalle de activo', () => pm.response.to.have.jsonSchema({type:'object', required:['id','risk_band','vulnerabilities','business_metrics'], properties:{vulnerabilities:{type:'array'}, business_metrics:{type:'array'}}}));",
                  "const a = pm.response.json();",
                  "pm.test('Riesgo del activo crítico con una vulnerabilidad', () => { pm.expect(a.risk_band).to.eql('critico'); pm.expect(a.vulnerabilities).to.have.lengthOf(1); });"
                ]
              }
            }
          ]
        },
        {
          "name": "13 Actualizar vulnerabilidad a 2 x 2 (recálculo)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analista_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/vulnerabilities/{{vuln_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "vulnerabilities",
                "{{vuln_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"probability\": 2,\n  \"impact\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "pm.test('Esquema de vulnerabilidad', () => pm.response.to.have.jsonSchema({type:'object', required:['id','asset_id','description','probability','impact','risk_score','risk_band','status','created_at'], properties:{probability:{type:'integer',minimum:1,maximum:5}, impact:{type:'integer',minimum:1,maximum:5}, risk_score:{type:'integer',minimum:1,maximum:25}, risk_band:{enum:['bajo','medio','alto','critico']}, status:{enum:['abierta','mitigada']}}}));",
                  "const v = pm.response.json();",
                  "pm.test('Riesgo recalculado 4, banda bajo', () => { pm.expect(v.risk_score).to.eql(4); pm.expect(v.risk_band).to.eql('bajo'); });"
                ]
              }
            }
          ]
        },
