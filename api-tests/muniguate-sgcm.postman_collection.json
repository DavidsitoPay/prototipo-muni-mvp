                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 401', () => pm.response.to.have.status(401));",
                  "pm.test('Esquema de error', () => pm.response.to.have.jsonSchema({type:'object', required:['detail'], properties:{detail:{type:'string'}}}));",
                  "pm.test('Mensaje de credenciales inválidas', () => pm.expect(pm.response.json().detail).to.eql('Usuario o contraseña incorrectos'));",
                  "pm.test('No devuelve token', () => pm.expect(pm.response.json()).to.not.have.property('access_token'));"
                ]
              }
