{
  "info": {
    "_postman_id": "9fde0ab3-1c8e-480a-ab99-c9c596a28eb9",
    "name": "Muniguate SGCM - Pruebas de API (E11)",
    "description": "Pruebas de API del backend de Muniguate SGCM. Ejecutar las carpetas en orden: la carpeta 1 obtiene los tokens que usan las demás y la carpeta 2 contiene el flujo de negocio encadenado (crea y luego elimina sus propios datos).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "01 Login Administrador TI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_user}}\",\n  \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Código 200', () => pm.response.to.have.status(200));",
                  "const schema = {type:'object', required:['access_token','token_type','user'], properties:{access_token:{type:'string'}, token_type:{type:'string'}, user:{type:'object', required:['id','username','role','display_name'], properties:{id:{type:'string'}, username:{type:'string'}, role:{type:'string'}, display_name:{type:'string'}}}}};",
                  "pm.test('Esquema de la respuesta de login', () => pm.response.to.have.jsonSchema(schema));",
                  "const login = pm.response.json();",
                  "pm.test('Tipo de token bearer y rol admin_ti', () => { pm.expect(login.token_type).to.eql('bearer'); pm.expect(login.user.role).to.eql('admin_ti'); });",
                  "pm.environment.set('admin_token', login.access_token);"
                ]
              }
            }
          ]
        },
